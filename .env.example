# ==============================================================================
# Ironory — Environment Configuration Template
# Copy this file to .env and adjust variables for your local or production setup.
# ==============================================================================

# Application Configuration
APP_NAME=Ironory
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API & Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://user:password@host:port/database_name
# For async drivers: postgresql+asyncpg://user:password@host:port/database_name
POSTGRES_USER=satendergupta
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=visioninspect
DATABASE_URL=postgresql://satendergupta@localhost:5432/visioninspect
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Test Database URL
TEST_DATABASE_URL=postgresql://satendergupta@localhost:5432/visioninspect_test

# Redis Configuration (Job queue & caching)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Configuration
# Generate a secure secret in production: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage/tenants
STORAGE_MAX_FILE_SIZE_MB=25

# ML Inference Configuration (CPU fallback enabled by default)
ML_DEVICE=cpu
ML_MODELS_DIR=./ml/artifacts
